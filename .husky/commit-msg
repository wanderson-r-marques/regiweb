$MSG = Get-Content -Path $args[0] -Raw

$PORTUGUESE_WORDS = @("adiciona", "altera", "corrige", "remove", "atualiza", "ajusta", "melhora", "refatora", "implementa", "cria", "testa", "teste", "adc", "alt", "corr", "rem", "atual", "ajs", "melhor", "impl", "del", "fix")

if ($MSG -match "^Merge|^Revert") {
    exit 0
}

$found = $false
foreach ($word in $PORTUGUESE_WORDS) {
    if ($MSG -imatch $word) {
        $found = $true
        break
    }
}

if (-not $found) {
    Write-Output "Erro: A mensagem do commit deve estar em Portugues (Brasil)."
    Write-Output "Use palavras como: adiciona, altera, corrige, remove, atualiza, implementa, etc."
    exit 1
}

exit 0